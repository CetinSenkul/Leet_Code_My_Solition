class Solution {
public:
    string longestCommonPrefix(vector<string>& strs) {
        string a="";
        for(int i=0;i<strs[0].size();++i){
            if(strs[0][i]==strs[1][i]&&strs[2][i]==strs[0][i]){
                a.push_back(strs[0][i]);
            }
        }
        return a;
    }
};
